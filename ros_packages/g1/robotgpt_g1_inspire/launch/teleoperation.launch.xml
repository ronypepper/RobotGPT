<?xml version="1.0" encoding="UTF-8"?>
<launch>
  <arg name="table_cam_sn" default="'243722075046'" />
  <arg name="left_wrist_cam_sn" default="'337122071131'" />
  <arg name="right_wrist_cam_sn" default="'241122072130'" />

  <arg name="disable_cameras" default="false" />

  <arg name="dataset_path" default="/RobotGPT/datasets/dataset.hdf5"/>
  <arg name="prompt" default="Pick up the blue cube and drop it in the bin"/>
  <arg name="record_fps" default="20"/>
  <arg name="mode" default="g1_proprietary_controller" />
  <arg name="use_real_hands" default="true" />
  <arg name="disable_left_hand" default="false" />
  <arg name="disable_right_hand" default="false" />
  <arg name="ik_visualization" default="false" />
  <arg name="assets_directory" default="/RobotGPT/robotgpt_ws/src/robotgpt_g1_inspire/assets" />

  <!-- Cameras -->
  <group unless="$(var disable_cameras)">
    <include file="$(find-pkg-share realsense2_camera)/launch/rs_launch.py">
      <arg name="camera_name" value="table_camera"/>
      <arg name="camera_namespace" value=""/>
      <arg name="rgb_camera.color_profile" value="640,480,30"/>
      <arg name="enable_depth" value="false"/>
      <arg name="serial_no" value="$(var table_cam_sn)"/>
    </include>
    <group unless="$(var disable_left_hand)">
      <include file="$(find-pkg-share realsense2_camera)/launch/rs_launch.py">
        <arg name="camera_name" value="left_wrist_camera"/>
        <arg name="camera_namespace" value=""/>
        <arg name="rgb_camera.color_profile" value="640,480,30"/>
        <arg name="enable_depth" value="false"/>
        <arg name="serial_no" value="$(var left_wrist_cam_sn)"/>
      </include>
    </group>
    <group unless="$(var disable_right_hand)">
      <include file="$(find-pkg-share realsense2_camera)/launch/rs_launch.py">
        <arg name="camera_name" value="right_wrist_camera"/>
        <arg name="camera_namespace" value=""/>
        <arg name="rgb_camera.color_profile" value="640,480,30"/>
        <arg name="enable_depth" value="false"/>
        <arg name="serial_no" value="$(var right_wrist_cam_sn)"/>
      </include>
    </group>
  </group>

  <!-- Robot control interface & demonstration recording -->
  <node name="robotgpt_isaac_teleop_controller" pkg="robotgpt_g1_inspire" exec="robotgpt_isaac_teleop_controller.launcher" output="screen">
    <param name="dataset_path" value="$(var dataset_path)"/>
    <param name="prompt" value="$(var prompt)"/>
    <param name="record_fps" value="$(var record_fps)"/>
    <param name="mode" value="$(var mode)"/>
    <param name="use_real_hands" value="$(var use_real_hands)"/>
    <param name="disable_left_hand" value="$(var disable_left_hand)"/>
    <param name="disable_right_hand" value="$(var disable_right_hand)"/>
  </node>

  <!-- Robot inverse kinematics -->
  <node name="robotgpt_inverse_kinematics" pkg="robotgpt_g1_inspire" exec="robotgpt_inverse_kinematics.launcher" output="screen">
    <param name="visualization" value="$(var ik_visualization)"/>
    <param name="assets_directory" value="$(var assets_directory)"/>
  </node>
</launch>
