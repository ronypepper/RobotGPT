<?xml version="1.0" ?>
<launch>
  <arg name="robot" default="fr3" doc="choose your robot. Possible values: [panda, fr3]"/>
  <arg name="robot_ip" default="franka3" doc="Robot IP address"/>
  <arg name="arm_id" default="$(arg robot)" />
  
  <arg name="isaac_teleop_ip" default="128.131.81.208"/>

  <arg name="publish_ee_pose_to_marker" default="False"/>
  <arg name="gripper_max_effort" default="1.0"/>
  <arg name="dataset_path" default="/home/asl_team/RobotGPT/datasets/dataset.hdf5"/>
  <arg name="prompt" default="Pick up the blue cube and drop it in the bin"/>
  <arg name="record_fps" default="50"/>

  <include file="$(find franka_control)/launch/franka_control.launch" pass_all_args="true"/>
  <rosparam command="load" file="$(find franka_example_controllers)/config/franka_example_controllers.yaml" subst_value="true" />
  <node name="controller_spawner" pkg="controller_manager" type="spawner" respawn="false" output="screen" args="cartesian_impedance_example_controller"/>
  <node pkg="rviz" type="rviz" output="screen" name="rviz" args="-d $(find franka_example_controllers)/launch/rviz/franka_description_with_marker.rviz -f $(arg arm_id)_link0 --splash-screen $(find franka_visualization)/splash.png"/>
  <node name="rqt_reconfigure" pkg="rqt_reconfigure" type="rqt_reconfigure" required="false" />

  <include file="$(find realsense2_camera)/launch/rs_camera.launch">
    <arg name="camera" value="wrist_camera"/>
    <arg name="serial_no" value="337122071131"/>
  </include>
  
  <node name="robotgpt_isaac_teleop_bridge_receiver" pkg="robotgpt" type="robotgpt_isaac_teleop_bridge_receiver.launcher" output="screen">
    <param name="isaac_teleop_ip" value="$(arg isaac_teleop_ip)"/>
  </node>
  <node name="robotgpt_isaac_teleop_controller" pkg="robotgpt" type="robotgpt_isaac_teleop_controller.launcher" output="screen">
    <param name="publish_ee_pose_to_marker" value="$(arg publish_ee_pose_to_marker)"/>
    <param name="gripper_max_effort" value="$(arg gripper_max_effort)"/>
    <param name="dataset_path" value="$(arg dataset_path)"/>
    <param name="prompt" value="$(arg prompt)"/>
    <param name="record_fps" value="$(arg record_fps)"/>
  </node>
</launch>
